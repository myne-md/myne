{
  "name": "myne",
  "private": true,
  "version": "0.19.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=24.11 <26",
    "pnpm": ">=11"
  },
  "scripts": {
    "start": "node scripts/dev-menu.mjs",
    "dev": "vite",
    "dev:reset": "bash scripts/dev-reset.sh",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "tsc -p web/tsconfig.json && vite build --config web/vite.config.ts && node scripts/emit-web-version.mjs",
    "web:preview": "vite preview --config web/vite.config.ts",
    "stories": "vite --config stories/vite.config.ts",
    "stories:build": "tsc -p stories/tsconfig.json && vite build --config stories/vite.config.ts",
    "stories:build:public": "tsc -p stories/tsconfig.json && STORIES_PUBLIC=1 vite build --config stories/vite.config.ts",
    "stories:preview": "vite preview --config stories/vite.config.ts",
    "stories:test": "vitest run --config .config/vitest/stories.config.ts",
    "stories:record": "STORIES_RECORD=1 vitest run --config .config/vitest/stories.config.ts tests/stories/drift.test.tsx",
    "mobile:dev": "pnpm --filter myne-mobile dev",
    "mobile:build": "pnpm --filter myne-mobile build",
    "mobile:test": "pnpm --filter myne-mobile test",
    "mobile:test:flow": "pnpm --filter myne-mobile test:flow",
    "mobile:ios": "pnpm --filter myne-mobile tauri ios dev",
    "mobile:ios:build": "pnpm --filter myne-mobile tauri ios build",
    "mobile:android": "pnpm --filter myne-mobile tauri android dev",
    "tauri": "tauri",
    "sidecar": "node scripts/build-cli-sidecar.mjs --profile debug && node scripts/build-mcp-sidecar.mjs --profile debug && node scripts/build-tor-sidecar.mjs --profile debug && node scripts/build-clipper-host.mjs --profile debug",
    "sidecar:release": "node scripts/build-cli-sidecar.mjs --profile release && node scripts/build-mcp-sidecar.mjs --profile release && node scripts/build-tor-sidecar.mjs --profile release && node scripts/build-clipper-host.mjs --profile release",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:seam:desktop": "vitest run tests/platform/tauri-seam.test.ts",
    "test:seam:web": "vitest run tests/platform/web-seam.test.ts",
    "test:e2e": "vitest run --config .config/vitest/e2e.config.ts",
    "pretest:e2e:web": "node scripts/check-web-wasm-freshness.mjs",
    "test:e2e:web": "vitest run --config .config/vitest/web-e2e.config.ts",
    "i18n:extract": "i18next-cli extract",
    "i18n:status": "i18next-cli status",
    "capture:userguide": "vitest run --config .config/vitest/capture.config.ts",
    "capture:stories": "node scripts/capture-stories.mjs",
    "coverage:rust": "cargo +nightly llvm-cov -p protocol --tests --html",
    "coverage:rust:summary": "cargo +nightly llvm-cov -p protocol --tests --summary-only",
    "coverage:rust:all": "pnpm build && cargo +nightly llvm-cov --workspace --tests --html",
    "models:fetch": "bash scripts/fetch-models.sh"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.10.3",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.11",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.0",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-rust": "6.0.2",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.12.3",
    "@codemirror/legacy-modes": "6.5.3",
    "@codemirror/search": "6.7.0",
    "@codemirror/state": "6.6.0",
    "@codemirror/view": "6.43.1",
    "@lezer/common": "1.5.2",
    "@lezer/highlight": "1.2.5",
    "@lezer/markdown": "1.6.4",
    "@myne/client-core": "workspace:*",
    "@myne/copy": "workspace:*",
    "@myne/dialect": "workspace:*",
    "@myne/editor": "workspace:*",
    "@myne/ornaments": "workspace:*",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-deep-link": "2.4.9",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@zxcvbn-ts/core": "^3.0.4",
    "@zxcvbn-ts/language-common": "^3.0.4",
    "@zxcvbn-ts/language-en": "^3.0.2",
    "d3-force": "3.0.0",
    "dompurify": "3.4.17",
    "i18next": "^26.3.4",
    "js-yaml": "4.3.2",
    "katex": "0.18.2",
    "mermaid": "11.16.1",
    "pdfjs-dist": "6.5.438",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.8",
    "w3c-keyname": "2.2.8"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.6.0",
    "@tauri-apps/cli": "^2.12.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/d3-force": "3.0.10",
    "@types/js-yaml": "4.0.9",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "4.1.8",
    "axe-core": "^4.12.1",
    "i18next-cli": "^1.64.1",
    "jsdom": "29.1.1",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "4.1.8"
  }
}
