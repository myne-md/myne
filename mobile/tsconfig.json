{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "paths": {
      "@myne/editor": ["../editor/src/index.ts"],
      "@myne/editor/CMEditor": ["../editor/src/CMEditor.tsx"],
      "@myne/editor/*": ["../editor/src/*"],
      "@myne/dialect": ["../dialect/src/index.ts"],
      "@myne/dialect/*": ["../dialect/src/*"],
      "@myne/sync-staleness": ["../src/lib/sync-staleness.ts"],
      "@myne/recovery-kit": ["../src/lib/recovery-kit.ts"],
      "@myne/locales-en": ["../locales/en/common.json"],
      "@myne/i18n": ["../src/i18n/index.ts"],
      "@myne/i18n/*": ["../src/i18n/*"],
      "@myne/reminder-schedule": ["../src/lib/reminderSchedule.ts"],
      "@myne/enroll-gate": ["../src/lib/enroll-gate.ts"],
      "@myne/legal-urls": ["../src/lib/legal-urls.ts"],
      "@myne/theme-measure": ["../src/lib/themeMeasure.ts"],
      "@myne/theme-canon": ["../src/lib/themeCanon.ts"],
      "@myne/clipboard": ["../src/lib/clipboard.ts"],
      "@myne/ornaments": ["../ornaments/src/index.ts"],
      "@myne/ornaments/*": ["../ornaments/src/*"],
      "@myne/task-wire": ["../src/notes/taskWire.ts"],
      "@myne/graph-overlay": ["../src/notes/graphOverlay.ts"],
      "@myne/view-version": ["../src/notes/views/viewVersion.ts"],
      "@myne/graph-color-groups": ["../src/notes/graphColorGroups.ts"],
      "@myne/task-panel": ["../src/notes/components/TaskListPanel.tsx"],
      "@myne/task-filters": ["../src/notes/taskFilters.ts"],
      "@myne/task-scope": ["../src/notes/taskScope.ts"],
      "@myne/task-view": ["../src/notes/taskView.ts"],
      "@myne/task-write": ["../src/notes/taskWriteCore.ts"],
      "@myne/note-completion": ["../src/notes/completeNoteCore.ts"],
      "@myne/agent-protocol": ["../src/lib/agent-protocol.ts"],
      "@myne/agent-store": ["../src/notes/agent/agentStore.ts"],
      "@myne/agent-run-core": ["../src/lib/agent-run-core.ts"],
      "@myne/run-cost-line": ["../src/notes/agent/components/RunCostLine.tsx"],
      "@myne/undo-last-run": ["../src/notes/agent/useUndoLastRun.ts"],
      "@myne/engine-error": ["../src/lib/engine-error.ts"],
      "@myne/decorations": ["../src/notes/decorations.ts"],
      "@myne/decorations/folderIcons": ["../src/notes/folderIcons.ts"],
      // The live-collaboration awareness cluster (myne-md/myne#849). See the alias
      // block in mobile/vite.config.ts for why these five are shared rather than
      // reimplemented; this list and that one are edited together.
      "@myne/awareness-store": ["../src/notes/collab/awarenessStore.ts"],
      "@myne/participant": ["../src/notes/collab/participant.ts"],
      "@myne/identity-label": ["../src/notes/collab/identityLabel.ts"],
      "@myne/presence-labels": ["../src/notes/collab/presenceLabels.ts"],
      "@myne/presence-jump": ["../src/notes/collab/presenceJump.ts"],
      "@myne/resolved-identity": ["../src/types/resolved-identity.ts"],
      // The shared meeting-note body builder (myne-md/myne#798). Pure — no
      // imports at all — so a watch meeting drained on mobile produces the SAME
      // note shape the desktop meeting session produces. A hand-copy is how the
      // two clients would silently disagree about the embed/transcript layout.
      "@myne/meeting-note": ["../src/notes/meetingNote.ts"],
      "@myne/note-mentions": ["../src/notes/ai/noteMentions.ts"]
    }
  },
  "include": ["src"]
}
