<?xml version="1.0" encoding="utf-8"?>
<!-- WG-02 (medium) · Quick capture resized wide — two independent tap targets
     (QuickCaptureWidget.kt binds myne://capture on @id/myne_btn_new_note and
     myne://capture?mode=voice on @id/myne_btn_voice). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/myne_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/myne_widget_bg"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="18dp"
    android:paddingEnd="20dp"
    android:paddingBottom="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:background="@drawable/myne_logo_bg_20"
            android:importantForAccessibility="no"
            android:src="@drawable/myne_mark" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="@string/myne_brand"
            android:textColor="@color/myne_ink_secondary"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/myne_encrypted_private"
            android:textColor="@color/myne_line2"
            android:textSize="12sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/myne_btn_new_note"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/myne_btn_accent"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/myne_ic_plus"
                android:tint="@color/myne_accent_on" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/myne_new_note"
                android:textColor="@color/myne_accent_on"
                android:textSize="16sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/myne_btn_voice"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/myne_btn_outline"
            android:contentDescription="@string/myne_voice_note"
            android:padding="17dp"
            android:src="@drawable/myne_ic_mic"
            android:tint="@color/myne_ink" />
    </LinearLayout>
</LinearLayout>
