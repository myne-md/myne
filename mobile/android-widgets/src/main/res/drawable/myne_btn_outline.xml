<?xml version="1.0" encoding="utf-8"?>
<!-- The medium capture widget's secondary (mic) button: paper-2 fill with a
     hairline border (radius 14). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/myne_paper2" />
    <stroke
        android:width="1dp"
        android:color="@color/myne_line" />
    <corners android:radius="14dp" />
</shape>
