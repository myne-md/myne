{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "default",
  "description": "Default capability for the main mobile window. Narrow by design — widen only with a named, scoped permission per command (security-load-bearing, TB6). Mirrors the desktop vault + notes + prefs plugin grants, trimmed to the mobile surface.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "deep-link:default",
    "vault-creation:default",
    "vault-unlock:default",
    "vault-recover:default",
    "vault-change-password:default",
    "vault-delete:default",
    "vault-repair:default",
    "prefs:default",
    "notes:default",
    "quick-unlock:default",
    "captures:default",
    "share-import:default",
    "vault-indices:default",
    "graph-layout:default",
    "search:default",
    "snapshots:default",
    "attachments:default",
    "export:default",
    "secret-export:default",
    "sync:default"
  ]
}
