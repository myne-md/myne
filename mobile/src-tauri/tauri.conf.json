{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Myne",
  "version": "0.10.1",
  "identifier": "md.myne.mobile",
  "build": {
    "beforeDevCommand": "pnpm sync-icons && pnpm dev",
    "devUrl": "http://localhost:1422",
    "beforeBuildCommand": "pnpm sync-icons && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Myne"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: attachment: http://attachment.localhost data: blob:; media-src 'self' attachment: http://attachment.localhost blob:; connect-src 'self' attachment: http://attachment.localhost; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": [
            "myne"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../src-tauri/resources/models/ocr": "models/ocr",
      "../../src-tauri/resources/models/whisper-tiny": "models/whisper"
    }
  }
}
