# Maintainer: Ömer Duran <78652445+omerdduran@users.noreply.github.com>
#
# Binary repackage of the released Debian bundle — the counterpart to
# ../PKGBUILD, which builds the same app from source.
#
# Why this file exists: v0.1.0 shipped `myne-bin-0.1.0-1-x86_64.pkg.tar.zst`,
# but the only committed PKGBUILD builds from git, so the recipe that actually
# produced that asset lived in a scratch directory and was gone by v0.2.0. This
# is that recipe, committed.
#
# Why repackage rather than rebuild: the from-source PKGBUILD needs the full
# Rust toolchain and ~40 min inside an Arch container to produce bytes we have
# already built and verified. Repackaging the .deb guarantees the Arch package
# carries the SAME file set the deb ships — the sidecars and the ~641 MiB model
# payload included — instead of a second build that could drift from it.
#
# That figure replaces a "~1.8 GB" this comment carried until ai-bundle-slim
# myne#190 task 8. **Nobody could reconcile 1.8 GB with anything measurable**:
# the declared payload is 671,889,625 bytes (640.76 MiB, byte-exact sum of every
# path in `bundle.resources`; run `node scripts/check-desktop-payload-budget.mjs`)
# and the amd64 deb it repackages is 602.64 MiB. Its provenance could not be
# determined, so it is replaced rather than adjusted. Ideally this number would
# be re-measured from the deb itself; the declared payload is used instead
# because it is reproducible from a checkout by anyone reading this line.
#
# `source` is a URL again, and the repo is still private — that combination is
# the point. The .deb is fetched from downloads.myne.md, the project's own
# artefact origin, which needs no credential because it is public even though
# github.com/myne-md/myne is not. This comment used to say "when the repo goes
# public, swap in the release URL"; standing up the origin got there first
# (`decisions.md` 2026-08-15, entry 0496).
#
# `sha256sums` carries the real hash rather than 'SKIP'. It is the same value
# the release's minisign-signed SHA256SUMS publishes and the same one myne.md
# lists, so `makepkg` refuses a substituted download instead of trusting the
# transport. Update it in the same edit as `pkgver`, never separately.
#
# Bumped to 0.17.0 on 2026-11-08. The hashes are the v0.17.0 debs
# (`Myne_0.17.0_amd64.deb` 156.2 MiB built natively on the VPS,
# `Myne_0.17.0_arm64.deb` 153.7 MiB built natively in the arm64 container); the
# source URLs resolve once the origin publishes `downloads.myne.md/releases/v0.17.0/`.

pkgname=myne-bin
_appname=myne
pkgver=0.18.0
pkgrel=1
pkgdesc="A calm place for your notes: clean, fast, end-to-end-encrypted markdown notes with [[wikilinks]], backlinks, a graph view and full-text search (binary release)"
arch=('x86_64' 'aarch64')
url="https://myne.md"
license=('AGPL-3.0-only')
depends=('webkit2gtk-4.1' 'gtk3' 'libayatana-appindicator' 'librsvg' 'openssl')
provides=("$_appname")
conflicts=("$_appname")
options=('!strip')

# One source per architecture, because the release publishes one .deb per
# architecture and the two are not interchangeable: the app carries native
# sidecars and a 640 MiB model payload.
source_x86_64=("https://downloads.myne.md/releases/v${pkgver}/Myne_${pkgver}_amd64.deb")
sha256sums_x86_64=('23435a5e1fa9f36d1c9b5829fa4e77539647d604ef8bd5072cde9d6fb11208aa')
source_aarch64=("https://downloads.myne.md/releases/v${pkgver}/Myne_${pkgver}_arm64.deb")
sha256sums_aarch64=('80f6a314dce6b2bed65d7fe930f50d127d0ab905f47b0a348763ae4c1a20336b')
# makepkg would otherwise try to unpack the .deb into $srcdir as a source
# archive. package() reads it directly instead, so the outer `ar` container and
# the inner data tarball stay paired.
# `$CARCH` spells the architecture the way pacman does (x86_64 / aarch64) but the
# published .deb says amd64 / arm64, so the two are mapped rather than assumed equal.
_debarch() { case "$CARCH" in aarch64) echo arm64 ;; *) echo amd64 ;; esac; }
_deb="Myne_${pkgver}_$(_debarch).deb"
noextract=("$_deb")

package() {
  # The deb's payload is already the FHS tree this package wants:
  #   usr/bin/{myne-desktop,myne,myne-tor}   the app, the CLI sidecar, the Tor sidecar
  #   usr/lib/Myne/{models,dictionaries}     bundled AI models + spell dictionaries
  #                                          (640.76 MiB declared: tag 475.36,
  #                                           whisper 78.76, ocr 21.06,
  #                                           dictionaries 74.51 — MiB, byte-exact)
  #   usr/share/{applications,icons,metainfo}
  # so extraction IS the packaging step. Nothing is rewritten — a divergence
  # between the deb and the Arch package would be a bug, not a feature.
  #
  # bsdtar reads the `ar` container natively, so this is one pipe: pull the
  # inner data tarball out of the .deb on stdout, unpack it into $pkgdir. The
  # glob covers whichever compression the bundler chose (data.tar.gz today).
  bsdtar -xOf "$srcdir/$_deb" 'data.tar.*' \
    | bsdtar -xf - -C "$pkgdir"

  # The deb declares no license file (Tauri's bundler does not emit one), so
  # attach the project's own for pacman's sake.
  install -Dm644 "$startdir/../../../LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
