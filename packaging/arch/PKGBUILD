# Maintainer: Ömer Duran <78652445+omerdduran@users.noreply.github.com>
pkgname=myne
pkgver=0.1.0
pkgrel=1
pkgdesc="A calm place for your notes — clean, fast, end-to-end-encrypted markdown notes with [[wikilinks]], backlinks, a graph view and full-text search"
arch=('x86_64')
url="https://myne.md"
license=('AGPL-3.0-only')
depends=('webkit2gtk-4.1' 'gtk3' 'libayatana-appindicator' 'librsvg' 'openssl')
makedepends=('cargo' 'pnpm' 'nodejs' 'git')
options=('!lto')
# ── Source ──────────────────────────────────────────────────────────────────
# For AUR / distribution: public git URL + version tag.
# NOTE: verify the <repo-url> and tag against your own remote (is the repo public?).
source=("$pkgname::git+https://github.com/myne-md/myne.git#tag=v$pkgver")
sha256sums=('SKIP')

prepare() {
  cd "$srcdir/$pkgname"
  pnpm install --frozen-lockfile
}

build() {
  cd "$srcdir/$pkgname"
  # Dedicated target dir for the package (independent of the host's ~/.cargo/shared-target).
  export CARGO_TARGET_DIR="$srcdir/target"
  # Produce a single executable with the frontend embedded — no Tauri installer
  # bundle (a raw binary instead of .deb/.AppImage; we do the pacman-native
  # packaging ourselves below).
  pnpm tauri build --no-bundle
}

package() {
  cd "$srcdir/$pkgname"
  local rel="$srcdir/target/release"

  # Executable → /usr/bin/myne
  install -Dm755 "$rel/myne-desktop" "$pkgdir/usr/bin/myne"

  # Desktop entry + AppStream metadata
  install -Dm644 "packaging/arch/myne.desktop" \
    "$pkgdir/usr/share/applications/md.myne.desktop.desktop"
  install -Dm644 "src-tauri/installer/md.myne.desktop.metainfo.xml" \
    "$pkgdir/usr/share/metainfo/md.myne.desktop.metainfo.xml"

  # Icons (hicolor)
  install -Dm644 "src-tauri/icons/32x32.png"      "$pkgdir/usr/share/icons/hicolor/32x32/apps/md.myne.desktop.png"
  install -Dm644 "src-tauri/icons/64x64.png"      "$pkgdir/usr/share/icons/hicolor/64x64/apps/md.myne.desktop.png"
  install -Dm644 "src-tauri/icons/128x128.png"    "$pkgdir/usr/share/icons/hicolor/128x128/apps/md.myne.desktop.png"
  install -Dm644 "src-tauri/icons/128x128@2x.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/md.myne.desktop.png"
  install -Dm644 "src-tauri/icons/icon.png"       "$pkgdir/usr/share/icons/hicolor/512x512/apps/md.myne.desktop.png"
}
