.DS_Store
*.swp
*.swo
*.bak
.idea/

# Editor / IDE
.vscode/*
!.vscode/extensions.json

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Node / Vite build output
node_modules/
# The trailing slash does not match a SYMLINK named `node_modules`, which is what
# a worktree sees when it links the shared checkout's install. Git then reports it
# untracked and `git add -A` commits the link.
node_modules
dist/
dist-ssr/
*.local
# The story catalogue's public variant (`pnpm stories:build:public`). A separate
# directory rather than a flag on `dist/` so the two builds cannot clobber each
# other and a reviewer can tell which one they are looking at.
stories/dist-public/

# Coverage reports (Vitest v8 → ./coverage; cargo-llvm-cov → /target/llvm-cov,
# already covered by /target/ below).
coverage/

# Cargo workspace build output. The workspace at the repo root produces
# artifacts in `/target/`; `src-tauri/.gitignore` still covers the legacy
# nested `src-tauri/target/` so neither path is ever committed.
/target/

# Stray empty files seen at repo root after running `pnpm tauri dev`.
# Anchored to root so they don't shadow legitimate paths in subdirectories.
/tauri
/myne@*

# Companion repos cloned by workspace/setup.sh as nested directories.
# Each carries its own .git and is tracked by GitHub separately under myne-md.
#
# NO TRAILING SLASH, and that is the fix rather than the style. A trailing slash
# matches a DIRECTORY only, and inside a worktree these are SYMLINKS to the
# shared checkout, which is what the documented worktree workflow produces. So
# every one of them was untracked-and-not-ignored in every worktree, and a
# `git add -A` before a commit would have put eight machine-specific absolute
# paths into a pull request. Without the slash the pattern matches either
# (myne-md/myne#609, found by review; the mitigation before this was a line in a
# progress log asking somebody to remember).
/myne-test-vectors
/myne-server
/myne-web
/myne-website
/myne-ops
/myne-agents
/myne-clipper
/myne-themes
/myne-branding
/myne-range
/homebrew-tap
/myne-pi-plugin

# Vite dep-optimization cache (regenerated each build).
.vite/

# OpenCode configuration. Commands, agents, plugins and skills are shared.
# Worktrees remain local machine state.
/.opencode/worktrees/

# The local sync server's store for `pnpm dev:two` and `pnpm web:local`
# (scripts/dev-web.sh): the accounts and vaults those commands create, kept so a
# restart reopens the same vault. Globbed because `web:local` appends its port when
# it has to move off 8787, so a second run gets a store of its own. Machine-local,
# exactly like the worktrees above, and never a thing to commit. The ignore rule is
# hygiene rather than a control, which is why `scripts/dev-web.sh` names what the
# directory holds.
/.opencode/dev-sync-store*/

# Playwright MCP working directory: viewport screenshots, accessibility
# snapshots, and console logs, regenerated by any browser-driven session.
.playwright-mcp/

# pnpm store leakage from the E2E container (scripts/e2e-local.sh)
.pnpm-store/
# E2E failure artifacts (screenshots, page source, driver logs)
e2e/artifacts/
# The web lane's own, same rule. A browser artifact is MORE sensitive than the
# desktop lane's: a page-source dump carries the rendered DOM, which on an
# unlocked vault is note plaintext. `e2e-web/support/artifacts.ts` redacts the
# known secrets before writing; this is the belt for everything it does not know
# about (phase3-web-client task 105).
e2e-web/artifacts/

# cli-thin-client task 11: the staged `myne` CLI sidecar Tauri's `externalBin`
# consumes. Pure build artefact — `scripts/build-cli-sidecar.mjs` rebuilds it from
# `cli/` on every `pnpm tauri dev` / `pnpm tauri build`, and its name carries the
# host target triple, so a committed copy would be wrong on every other platform.
# Same reasoning as `web/wasm/pkg/` below: a multi-MB binary in every diff, and a
# bundle whose contents depend on whoever last ran the script.
src-tauri/binaries/
# The trailing slash above does not match a SYMLINK named `binaries`, which is
# what a worktree sees when it links the shared checkout's staged sidecars. Git
# then reports it untracked and a `git add -A` commits the link. The bare
# pattern matches both the real directory and the symlink.
src-tauri/binaries

# phase3-web-client task 11: the wasm-bindgen output for `web/wasm`. Pure build
# artefact — derived from `web/wasm/src/` plus the pinned toolchain by
# `scripts/build-wasm.sh`. Committing it would put a 128 KiB binary in every diff
# and make the reproducible-bundle-hash story (A15) depend on whoever last ran
# the script rather than on the source.
web/wasm/pkg/
web/bench/pkg/

# E2E run reports (json floor evidence + junit flake history) — regenerated per run.
.e2e-report/

# Agent scratch: local permission allow-lists and per-machine settings. The
# website ignores the same directory; nothing in it is a repo artefact.
/.claude/

# Sidebar state: written by myne-sidebar.ts, machine-local, never committed.
.pi/.state/
