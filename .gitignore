.DS_Store
*.swp
*.swo
*.bak
.idea/

# Editor / IDE
.vscode/*
!.vscode/extensions.json

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Node / Vite build output
node_modules/
dist/
dist-ssr/
*.local

# Coverage reports (Vitest v8 → ./coverage; cargo-llvm-cov → /target/llvm-cov,
# already covered by /target/ below).
coverage/

# Cargo workspace build output. The workspace at the repo root produces
# artifacts in `/target/`; `src-tauri/.gitignore` still covers the legacy
# nested `src-tauri/target/` so neither path is ever committed.
/target/

# Stray empty files seen at repo root after running `pnpm tauri dev`.
# Anchored to root so they don't shadow legitimate paths in subdirectories.
/tauri
/myne@*

# Companion repos cloned by workspace/setup.sh as nested directories.
# Each carries its own .git and is tracked by GitHub separately under myne-md.
/myne-test-vectors/
/myne-server/
/myne-web/
/myne-mobile/
/myne-website/
/operations/
/agent-tooling/
/myne-clipper/
/myne-themes/
/myne-branding/
/myne-status/

# Vite dep-optimization cache (regenerated each build).
.vite/

/.claude/

# Playwright MCP working directory: viewport screenshots, accessibility
# snapshots, and console logs regenerated by every penpot-sync run. Reference
# canvas exports live in /tmp/ during a session and are not tracked.
.playwright-mcp/

# Ephemeral output of penpot-sync skill when Plugin API limits prevent
# automated fixes — lists manual UI steps the user needs to take.
manual-fixes-needed.md

# pnpm store leakage from the E2E container (scripts/e2e-local.sh)
.pnpm-store/
# E2E failure artifacts (screenshots, page source, driver logs)
e2e/artifacts/
# The web lane's own, same rule. A browser artifact is MORE sensitive than the
# desktop lane's: a page-source dump carries the rendered DOM, which on an
# unlocked vault is note plaintext. `e2e-web/support/artifacts.ts` redacts the
# known secrets before writing; this is the belt for everything it does not know
# about (phase3-web-client task 105).
e2e-web/artifacts/

# cli-thin-client task 11: the staged `myne` CLI sidecar Tauri's `externalBin`
# consumes. Pure build artefact — `scripts/build-cli-sidecar.mjs` rebuilds it from
# `cli/` on every `pnpm tauri dev` / `pnpm tauri build`, and its name carries the
# host target triple, so a committed copy would be wrong on every other platform.
# Same reasoning as `web/wasm/pkg/` below: a multi-MB binary in every diff, and a
# bundle whose contents depend on whoever last ran the script.
src-tauri/binaries/

# phase3-web-client task 11: the wasm-bindgen output for `web/wasm`. Pure build
# artefact — derived from `web/wasm/src/` plus the pinned toolchain by
# `scripts/build-wasm.sh`. Committing it would put a 128 KiB binary in every diff
# and make the reproducible-bundle-hash story (A15) depend on whoever last ran
# the script rather than on the source.
web/wasm/pkg/
web/bench/pkg/

# E2E run reports (json floor evidence + junit flake history) — regenerated per run.
.e2e-report/
