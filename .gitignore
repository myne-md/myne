.DS_Store
*.swp
*.swo
*.bak
.idea/

# Editor / IDE
.vscode/*
!.vscode/extensions.json

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Node / Vite build output
node_modules/
dist/
dist-ssr/
*.local

# Cargo workspace build output. The workspace at the repo root produces
# artifacts in `/target/`; `src-tauri/.gitignore` still covers the legacy
# nested `src-tauri/target/` so neither path is ever committed.
/target/

# Stray empty files seen at repo root after running `pnpm tauri dev`.
# Anchored to root so they don't shadow legitimate paths in subdirectories.
/tauri
/myne@*

# Companion repos cloned by workspace/setup.sh as nested directories.
# Each carries its own .git and is tracked by GitHub separately under myne-md.
/myne-test-vectors/
/myne-server/
/myne-web/
/myne-mobile/
/myne-website/
/myne-ops/
/myne-agents/

/.claude/

# Playwright MCP working directory: viewport screenshots, accessibility
# snapshots, and console logs regenerated by every penpot-sync run. Reference
# canvas exports live in /tmp/ during a session and are not tracked.
.playwright-mcp/

# Ephemeral output of penpot-sync skill when Plugin API limits prevent
# automated fixes — lists manual UI steps the user needs to take.
manual-fixes-needed.md

# pnpm store leakage from the E2E container (scripts/e2e-local.sh)
.pnpm-store/
# E2E failure artifacts (screenshots, page source, driver logs)
e2e/artifacts/
