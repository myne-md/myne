{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Myne",
  "version": "0.16.0",
  "identifier": "md.myne.desktop",
  "build": {
    "beforeDevCommand": "pnpm sidecar && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm sidecar:release && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Myne",
        "width": 1100,
        "height": 720,
        "minWidth": 880,
        "minHeight": 600,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 20 },
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: attachment: http://attachment.localhost data: blob:; media-src 'self' attachment: http://attachment.localhost blob:; object-src 'none'; connect-src 'self' ipc: http://ipc.localhost attachment: http://attachment.localhost; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; frame-src 'self' attachment: http://attachment.localhost blob:; worker-src 'self' blob:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["myne"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXkgQTNDNzZCQTAzREUzREY2NApSV1JrMytNOW9HdkhvMzNvSGc1a09MN2E1RGJOajhzUjJLUExnMGd3SE11am5IT3BRSStrWCtubQ==",
      "requireSignedVersion": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "Myne",
    "homepage": "https://myne.md",
    "category": "Productivity",
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "name": "Markdown",
        "description": "Markdown document",
        "role": "Editor",
        "mimeType": "text/markdown",
        "rank": "Alternate",
        "contentTypes": ["net.daringfireball.markdown"]
      }
    ],
    "shortDescription": "A calm place for your notes.",
    "longDescription": "Myne is a clean, fast markdown notes app. Capture, link, and find your notes across devices — calmly, without lock-in. A markdown editor with [[wikilinks]], backlinks, a graph view, and full-text search; no email to sign up; your notes stay plaintext-readable markdown after decryption.",
    "macOS": {
      "entitlements": "entitlements.plist",
      "files": { "embedded.provisionprofile": "Myne_Mac_DeveloperID.provisionprofile" },
      "minimumSystemVersion": "10.15",
      "dmg": {
        "background": "dmg/background.png",
        "windowSize": { "width": 660, "height": 420 },
        "appPosition": { "x": 170, "y": 250 },
        "applicationFolderPosition": { "x": 490, "y": 250 }
      }
    },
    "windows": {
      "nsis": {
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp"
      }
    },
    "linux": {
      "deb": {
        "files": {
          "/usr/share/metainfo/md.myne.desktop.metainfo.xml": "installer/md.myne.desktop.metainfo.xml"
        }
      },
      "rpm": {
        "files": {
          "/usr/share/metainfo/md.myne.desktop.metainfo.xml": "installer/md.myne.desktop.metainfo.xml"
        }
      },
      "appimage": {
        "files": {
          "/usr/share/metainfo/md.myne.desktop.metainfo.xml": "installer/md.myne.desktop.metainfo.xml"
        }
      }
    },
    "externalBin": ["binaries/myne", "binaries/myne-mcp", "binaries/myne-tor", "binaries/myne-clipper-host"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/dictionaries/en-US": "dictionaries/en-US",
      "resources/dictionaries/en-GB": "dictionaries/en-GB",
      "resources/dictionaries/bg": "dictionaries/bg",
      "resources/dictionaries/ca": "dictionaries/ca",
      "resources/dictionaries/de": "dictionaries/de",
      "resources/dictionaries/es": "dictionaries/es",
      "resources/dictionaries/fa": "dictionaries/fa",
      "resources/dictionaries/fr": "dictionaries/fr",
      "resources/dictionaries/he": "dictionaries/he",
      "resources/dictionaries/hu": "dictionaries/hu",
      "resources/dictionaries/it": "dictionaries/it",
      "resources/dictionaries/ko": "dictionaries/ko",
      "resources/dictionaries/lt": "dictionaries/lt",
      "resources/dictionaries/lv": "dictionaries/lv",
      "resources/dictionaries/nl": "dictionaries/nl",
      "resources/dictionaries/pl": "dictionaries/pl",
      "resources/dictionaries/pt": "dictionaries/pt",
      "resources/dictionaries/ro": "dictionaries/ro",
      "resources/dictionaries/ru": "dictionaries/ru",
      "resources/dictionaries/sk": "dictionaries/sk",
      "resources/dictionaries/sl": "dictionaries/sl",
      "resources/dictionaries/sv": "dictionaries/sv",
      "resources/models/whisper": "models/whisper",
      "resources/models/ocr": "models/ocr"
    }
  }
}
