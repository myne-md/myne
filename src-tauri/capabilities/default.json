{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "core:window:allow-start-dragging",
    "core:window:allow-show",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "$APPDATA/vaults/*" }, { "path": "$APPDATA/vault" }]
    },
    "opener:allow-reveal-item-in-dir",
    "vault-creation:default",
    "vault-unlock:default",
    "vault-recover:default",
    "vault-change-password:default",
    "vault-delete:default",
    "vault-repair:default",
    "quick-unlock:default",
    "prefs:default",
    "themes:default",
    "notes:default",
    "snapshots:default",
    "sync:default",
    "vault-indices:default",
    "attachments:default",
    "importer:default",
    "backup:default",
    "export:default",
    "pdf-export:default",
    "workspace:default",
    "spell:default",
    "clipper-pairing:default",
    "clipboard-manager:allow-write-text",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-clear",
    "dialog:allow-save",
    "dialog:allow-open",
    "dialog:allow-confirm",
    "secret-export:default"
  ]
}
